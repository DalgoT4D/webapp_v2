# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ai dev tool related
# Share team config (CLAUDE.md, rules/, skills/, agents/, settings.json) — ignore only personal/local bits
.claude/settings.local.json
# Machine-local Claude Code permission grants. Tracked previously, but the
# format:write pre-commit hook ('git add .') swept it into unrelated commits.
.claude/settings.json
.claude/worktrees/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/.playwright-mcp/
/dash1-view.png

# Sentry Config File
.env.sentry-build-plugin

# Playwright MCP session artifacts (console logs, traces)
.playwright-mcp/

# E2E baselines: recorded from pre-refactor code, kept local only (see e2e/README.md)
/e2e/__snapshots__/**/*.json
/e2e/__snapshots__/**/*.png
/e2e/__snapshots__/**/*.txt

# Mutation drill outputs (e2e/scripts/mutation)
/e2e/scripts/mutation/mutation-*.jsonl
/e2e/scripts/mutation/mutation-*.log
/e2e/scripts/mutation/__pycache__/

.bruin.yml